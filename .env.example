# Zkopíruj do `.env` a doplň hodnoty. Soubor `.env` je v .gitignore.
# Čtou ho jak Next.js (runtime), tak Prisma CLI (migrace).

# API-Football (Pro tarif) – klíč drž jen na serveru, nikdy v klientovi.
API_FOOTBALL_KEY=

# Neon Postgres – POOLED připojení (běh aplikace, host obsahuje -pooler).
DATABASE_URL=postgresql://user:pass@ep-xxx-pooler.region.aws.neon.tech/dbname?sslmode=require

# Ochrana warm/cron endpointů. Technicky volitelné, PRO OSTRÝ PROVOZ ALE NUTNÉ:
# bez něj `requireCronAuth` pouští všechny (fail-open), takže `/api/warm?league=ID`
# = stovky volání API-Football na jeden request může spustit kdokoli a vyčerpat
# denní kvótu. Vercel Cron posílá `Authorization: Bearer <CRON_SECRET>` sám, jakmile
# je proměnná v prostředí → nastavit ji stačí ve Vercelu (+ redeploy), kód se nemění.
CRON_SECRET=

# ── Auth.js (přihlašování / účty) ────────────────────────────────────────
# Náhodné tajemství pro podpis session (vygeneruj: `npx auth secret` nebo openssl).
AUTH_SECRET=
# Google OAuth (Google Cloud Console → OAuth client, web). Redirect URI:
#   http://localhost:3000/api/auth/callback/google  (a produkční varianta)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Stabilní veřejná URL aplikace. Bez ní bere Auth.js host z requestu = deployment-specific
# URL Vercelu (mění se každým buildem) → Google vrátí `redirect_uri_mismatch`. Slouží
# i jako base pro OG obrázky, sitemap a Stripe redirecty.
AUTH_URL=https://statapp-uvol.vercel.app
# Always-PRO allowlist (e-maily oddělené čárkou) – přepíše tier bez ohledu na DB.
PRO_EMAILS=
# Pozn. (tento stroj): Google token exchange = odchozí TLS → spouštěj dev s
# NODE_OPTIONS=--use-system-ca. Na Vercelu netřeba.

# ── Stripe (PRO předplatné) ──────────────────────────────────────────────
# Bez těchto proměnných je platební cesta jen vypnutá (routy vrací 503), appka běží dál.
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
# Z `stripe listen --forward-to localhost:3000/api/stripe/webhook` (lokál) nebo
# z webhook endpointu v dashboardu (produkce).
STRIPE_WEBHOOK_SECRET=
